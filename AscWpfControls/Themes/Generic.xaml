<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AscWpfControls.Controls">

    <!-- Ein Knopf ohne Skala und ohne Zahl: Anfang und Ende gibt es hier nicht, die Markierung
         zeigt nur, dass und wie schnell gedreht wird.

         Gezeichnet wird auf einer festen Flaeche von 28x28, die eine Viewbox gleichmaessig auf die
         tatsaechliche Groesse skaliert. Damit bleibt der Regler auch dann rund, wenn ihm jemand
         unterschiedliche Width/Height gibt oder ein Container ihn streckt - und Strichstaerke,
         Markierung und Fokusring wachsen im richtigen Verhaeltnis mit.

         Der Fokusring liegt bewusst INNERHALB dieser Flaeche: Er ragte frueher darueber hinaus, was
         bei einem kleinen Knopf niemandem auffiel, bei einem grossen aber die Nachbarn ueberlappte -
         das Layout kennt nur die Groesse des Controls, nicht was darueber hinausgemalt wird. Der
         Knopf selbst ist deshalb 26 der 28 Einheiten breit; die zwei Einheiten Rand sind der Platz,
         in dem der Ring erscheint. Wer mehr Luft will, setzt zusaetzlich Padding.

         Alle drei Markierungen stecken in diesem einen Template und werden ueber MarkerKind
         umgeschaltet, statt drei Templates zu pflegen. Die Deckkraft sitzt am drehenden Grid, damit
         der Trigger fuer "wird gerade gedreht" nicht wissen muss, welche Markierung gerade sichtbar
         ist. -->
    <Style TargetType="{x:Type controls:RotaryEncoder}">
        <Setter Property="Cursor" Value="ScrollNS" />
        <Setter Property="Foreground" Value="#3A6EA5" />
        <Setter Property="MarkerBrush" Value="#3A6EA5" />
        <Setter Property="FocusRingBrush" Value="#3A6EA5" />
        <Setter Property="Background" Value="#F2F2F2" />
        <Setter Property="BorderBrush" Value="#9A9A9A" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ToolTip" Value="Ziehen, scrollen oder Pfeiltasten – ohne Anschlag" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RotaryEncoder}">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="28" Height="28">
                                <Ellipse x:Name="Ring" Margin="1"
                                         Fill="{TemplateBinding Background}"
                                         Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" />

                                <!-- Das drehende Grid: Es rotiert um die Mitte des Knopfes, nicht um
                                     die Mitte der jeweiligen Markierung. -->
                                <Grid x:Name="Markierung" RenderTransformOrigin="0.5,0.5" Opacity="0.7">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="{Binding Angle, RelativeSource={RelativeSource TemplatedParent}}" />
                                    </Grid.RenderTransform>

                                    <Rectangle x:Name="Kerbe" Width="2.5" Height="8"
                                               Fill="{TemplateBinding MarkerBrush}"
                                               RadiusX="1.25" RadiusY="1.25"
                                               HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Margin="0,4,0,0" />

                                    <Rectangle x:Name="Zeiger" Width="2" Height="11" Visibility="Collapsed"
                                               Fill="{TemplateBinding MarkerBrush}"
                                               RadiusX="1" RadiusY="1"
                                               HorizontalAlignment="Center" VerticalAlignment="Top"
                                               Margin="0,3,0,0" />

                                    <Ellipse x:Name="Nabe" Width="3.5" Height="3.5" Visibility="Collapsed"
                                             Fill="{TemplateBinding MarkerBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <Ellipse x:Name="Punkt" Width="4" Height="4" Visibility="Collapsed"
                                             Fill="{TemplateBinding MarkerBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Top"
                                             Margin="0,3.5,0,0" />
                                </Grid>

                                <Ellipse x:Name="Fokusring" Margin="0.25"
                                         Stroke="{TemplateBinding FocusRingBrush}"
                                         StrokeThickness="0.5" StrokeDashArray="2 2"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Viewbox>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="MarkerKind" Value="Pointer">
                            <Setter TargetName="Kerbe" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Zeiger" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Nabe" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="MarkerKind" Value="Dot">
                            <Setter TargetName="Kerbe" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Punkt" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <!-- Beim Drehen wird die Markierung kraeftiger, nicht laenger: Eine Laenge, die
                             beim Anfassen springt, sieht nach einem Ruck aus - und der Sprung waechst
                             mit der Groesse des Knopfes mit. -->
                        <Trigger Property="IsTurning" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="#E4EDF6" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Markierung" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fokusring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================  Field: chrome, actions, text field  ==================== -->

    <!-- A button inside a field. The icon comes in four stages (see FieldAction): the built-in
         path, an own path via IconGeometry, an own Content, or an own template. The Path is only
         drawn while Content is empty - otherwise the two would sit on top of each other. -->
    <Style TargetType="{x:Type controls:FieldAction}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#767676" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FieldAction}">
                    <Border x:Name="Backdrop" Background="Transparent" CornerRadius="2">
                        <Grid>
                            <Viewbox x:Name="Icon" Margin="2" Stretch="Uniform">
                                <Path Data="{TemplateBinding IconGeometry}"
                                      Fill="{TemplateBinding Foreground}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="{TemplateBinding IconStrokeThickness}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Viewbox>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#E1E1E1" />
                            <Setter Property="Foreground" Value="#1F1F1F" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Backdrop" Property="Background" Value="#CFCFCF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:ClearAction}"
           BasedOn="{StaticResource {x:Type controls:FieldAction}}">
        <Setter Property="IconGeometry" Value="{x:Static controls:ClearAction.DefaultIcon}" />
        <Setter Property="ToolTip" Value="Clear" />
        <Setter Property="AutomationProperties.Name" Value="Clear" />
    </Style>

    <!-- The eye gains a stroke through it once the content is in clear, so the button says which
         way it is about to go rather than only what it is. Both shapes are filled outlines from
         Fluent UI System Icons; a stroked eye at sixteen pixels is a blob with a line in it. -->
    <Style TargetType="{x:Type controls:RevealAction}"
           BasedOn="{StaticResource {x:Type controls:FieldAction}}">
        <Setter Property="IconGeometry" Value="{x:Static controls:RevealAction.DefaultIcon}" />
        <Setter Property="ToolTip" Value="Show" />
        <Setter Property="AutomationProperties.Name" Value="Show" />
        <Style.Triggers>
            <Trigger Property="IsRevealed" Value="True">
                <Setter Property="IconGeometry" Value="{x:Static controls:RevealAction.RevealedIcon}" />
                <Setter Property="ToolTip" Value="Hide" />
                <Setter Property="AutomationProperties.Name" Value="Hide" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The trim: border, placeholder and the strip of actions, with a hole in the middle for the
         editor. It is not hit-testable - clicking it has to land in the field, or the caret would
         refuse to appear where the user pointed.

         Only the placeholder carries the padding, NOT the content presenter. A TextBox applies its
         own Padding to the text already; adding it again here gave the text twice the inset and the
         placeholder once, so the placeholder started a whole character to the left of the caret.
         Measured at 6 DIP against a Padding of 5 - and gone at Padding 0, which is what identified
         it as double counting rather than some inset inside the editor. -->
    <Style TargetType="{x:Type controls:FieldChrome}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#9A9A9A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FieldChrome}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="Editor" Grid.Column="0" VerticalAlignment="Center" />

                            <!-- The mask covers the editor rather than replacing its content: the
                                 field's Text keeps the real value at all times, and hiding stays a
                                 matter of display. Anything else would have made Text mean one
                                 thing on screen and another in a binding. -->
                            <TextBlock x:Name="Mask" Grid.Column="0"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{TemplateBinding MaskText}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />

                            <TextBlock x:Name="Placeholder" Grid.Column="0"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="#9A9A9A"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel x:Name="PART_Actions" Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="2,0,4,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPlaceholderVisible" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMaskVisible" Value="True">
                            <Setter TargetName="Mask" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Editor" Property="Visibility" Value="Hidden" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The field itself. Its template is the trim with the editor placed in the hole; everything
         that looks like a text box comes from TextBox, everything around it from FieldChrome. -->
    <Style TargetType="{x:Type controls:TextField}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#9A9A9A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TextField}">
                    <controls:FieldChrome x:Name="Chrome"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Padding="{TemplateBinding Padding}"
                                          PlaceholderText="{TemplateBinding PlaceholderText}"
                                          IsPlaceholderVisible="{TemplateBinding IsPlaceholderVisible}"
                                          MaskText="{TemplateBinding MaskText}"
                                          IsMaskVisible="{TemplateBinding IsMasked}"
                                          Actions="{TemplateBinding Actions}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </controls:FieldChrome>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#3A6EA5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
